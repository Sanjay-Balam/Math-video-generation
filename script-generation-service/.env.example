# LLM Provider Configuration
# Choose your provider: 'gemini' or 'openrouter'
LLM_PROVIDER=openrouter

# OpenRouter API Key (Free tier available)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=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

# Google Gemini API Key (Optional - if using Gemini)
# GEMINI_API_KEY=your_gemini_api_key_here

# Qdrant Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=optional_api_key

# Server Configuration
PORT=5000
NODE_ENV=development

# Video Generation Service Configuration
VIDEO_SERVICE_URL=http://localhost:8001
VIDEO_SERVICE_TIMEOUT=300000
VIDEO_POLLING_INTERVAL=5000
VIDEO_MAX_RETRIES=3
DEFAULT_VIDEO_QUALITY=medium_quality
DEFAULT_VIDEO_FORMAT=mp4
DEFAULT_FRAME_RATE=30